{
  "name": "staxly",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "author": "Philip Schatz <phil@cnx.org>",
  "license": "ISC",
  "repository": "https://github.com/openstax/staxly.git",
  "keywords": [
    "probot",
    "github",
    "probot-app"
  ],
  "scripts": {
    "dev": "nodemon",
    "lint": "standard --fix",
    "start": "probot run ./index.cjs",
    "test": "IGNORE_FOR_TESTING=true jest --coverage && standard --fix",
    "test:debug": "NODE_ENV=development IGNORE_FOR_TESTING=true node --inspect-brk $(npm bin)/jest -i --updateSnapshot",
    "test:watch": "IGNORE_FOR_TESTING=true jest --watch --notify --notifyMode=change --coverage"
  },
  "dependencies": {
    "@slack/bolt": "^4.7.3",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "probot": "^13.4.7",
    "probot-addon-settings": "github:probot/settings#v4.1.11",
    "probot-config": "^1.1.0",
    "sax": "^1.2.4",
    "smee-client": "^1.2.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.17.0",
    "@babel/preset-env": "^7.16.11",
    "@babel/runtime": "^7.29.7",
    "babel-jest": "^29.0.0",
    "jest": "^29.0.0",
    "nock": "^14.0.0",
    "nodemon": "^2.0.15",
    "standard": "^16.0.4"
  },
  "engines": {
    "node": "22.x"
  },
  "standard": {
    "parser": "@babel/eslint-parser",
    "env": [
      "jest"
    ],
    "globals": ["fetch"]
  },
  "jest": {
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "/node_modules/(?!(probot-addon-settings)/)"
    ]
  },
  "nodemonConfig": {
    "exec": "npm start",
    "watch": [
      ".env",
      "."
    ]
  }
}
